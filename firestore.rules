rules_version = '2';

// Only the salon's own account may touch anything. The email must match `salonEmail` in src/config.js.
// (Pinning the email matters: with email/password sign-in enabled, anyone could otherwise create
// their own account with the public API key and read the data.)
service cloud.firestore {
  match /databases/{database}/documents {

    function isSalon() {
      return request.auth != null
        && request.auth.token.email == 'salon@yasmin.app';
    }

    function validAppointment(d) {
      return d.keys().hasOnly(['client_name', 'phone', 'date', 'time', 'service', 'price', 'status', 'walk_in', 'note', 'created_at', 'payments', 'due', 'source', 'wa_notified'])
        && d.keys().hasAll(['client_name', 'phone', 'date', 'time', 'service', 'price', 'status', 'walk_in', 'note', 'created_at', 'payments', 'due'])
        && (!('source' in d) || d.source == 'whatsapp')
        && (!('wa_notified' in d) || d.wa_notified is string)
        && d.client_name is string && d.client_name.size() > 0 && d.client_name.size() <= 80
        && d.phone is string && d.phone.size() <= 30
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.time is string && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d['service'] is string && d['service'].size() <= 120
        && d.price is number && d.price >= 0 && d.price <= 10000000
        && d.status in ['pending', 'booked', 'came', 'no_show', 'cancelled']
        && d.walk_in is bool
        && d.note is string && d.note.size() <= 1000
        && d.created_at is string
        && d.payments is list && d.payments.size() <= 200
        && d.due is number && d.due >= 0;
    }

    function validNote(d) {
      return d.keys().hasOnly(['text', 'pinned', 'done', 'created_at'])
        && d.keys().hasAll(['text', 'pinned', 'done', 'created_at'])
        && d.text is string && d.text.size() > 0 && d.text.size() <= 2000
        && d.pinned is bool && d.done is bool
        && d.created_at is string;
    }

    match /appointments/{id} {
      allow read, delete: if isSalon();
      allow create, update: if isSalon() && validAppointment(request.resource.data);
    }

    // written only by the WhatsApp bot (Admin SDK); the app just shows it
    match /bot_status/{id} {
      allow read: if isSalon();
    }

    match /notes/{id} {
      allow read, delete: if isSalon();
      allow create, update: if isSalon() && validNote(request.resource.data);
    }
  }
}
