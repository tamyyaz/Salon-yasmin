# انسخ هذا الملف إلى .env (على كمبيوتر البوت فقط) واملأ القيم. لا ترفعه لـ git.

# مسار ملف مفتاح حساب الخدمة (JSON) للمشروع salon-yasmin — انظر README
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# لربط رقم الصالون بكود من 8 خانات بدل QR: الرقم بصيغة دولية بدون + (مثال 962791234567). اتركه فارغاً لاستعمال QR
WA_PAIR_NUMBER=

# المنطقة الزمنية للصالون (IANA)
SALON_TZ=Asia/Amman
